# Copia in .env o imposta queste variabili nell'host. NON committare valori reali.
# Tutto ciò che è facoltativo resta DISATTIVATO se non configurato.

# --- Server base ---
PORT=8787
# URL pubblico dell'app (usato nei link delle email e per il ritorno OAuth). Obbligatorio per email, recupero password, Strava.
APP_URL=http://localhost:8787
# Dove vengono salvati i dati (file JSON, scrittura atomica). Su hosting con disco effimero serve un disco persistente.
DATA_FILE=./data/db.json
# Dietro un proxy/CDN (es. Render): 1 per leggere l'IP reale da X-Forwarded-For.
TRUST_PROXY=0
# Se impostato, per registrarsi serve questo codice (utile per un gruppo chiuso).
REGISTRATION_CODE=
REGISTER_LIMIT_PER_HOUR=10

# --- Email (recupero password e verifica email). Senza questa sezione il recupero è dichiarato "non disponibile". ---
# Resend (piano gratuito); crea la chiave su https://resend.com e verifica un dominio per inviare a chiunque.
RESEND_API_KEY=
MAIL_FROM="PODISMO SOCIAL <noreply@tuodominio.it>"

# --- Accesso con Google / Apple (opzionali, solo con credenziali reali) ---
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# --- Cifratura dei token a riposo (obbligatoria per Strava). Genera con: openssl rand -base64 32 ---
TOKEN_ENCRYPTION_KEY=

# --- Strava (opzionale). Vedi docs/INTEGRAZIONI.md ---
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# STRAVA_SCOPE=read,activity:read
# STRAVA_MAX_PAGES=8
# STRAVA_REQUESTS_PER_15MIN=80
# STRAVA_SYNC_COOLDOWN_MS=300000

# --- Mappe, ricerca luoghi e percorsi (opzionali) ---
# Ricerca luoghi (Nominatim): serve un recapito per identificare l'app, come richiesto dalla policy.
GEO_CONTACT_EMAIL=
# Calcolo percorsi a piedi: OpenRouteService (chiave gratuita) OPPURE un OSRM con profilo "foot" tuo.
ORS_API_KEY=
# OSRM_URL=
# Tessere della mappa (default: OpenStreetMap, solo per uso leggero). Per uso intensivo scegli un fornitore dedicato.
# TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# TILE_ATTRIBUTION="© OpenStreetMap contributors"
# GEO_SEARCH_DAILY_CAP=1000
# GEO_ROUTE_DAILY_CAP=1500

# --- Meteo Open-Meteo: DISATTIVATO di default (gratis solo per uso NON commerciale, vedi docs/INTEGRAZIONI.md) ---
WEATHER_ENABLED=0
# OPEN_METEO_API_KEY=
# WEATHER_DAILY_CAP=5000

# --- Coach AI (Cloudflare Workers AI tramite Worker dedicato). DISATTIVATO di default ---
AI_ENABLED=0
AI_WORKER_URL=
# Stesso valore del secret SHARED_SECRET del Worker.
AI_WORKER_SECRET=
AI_DAILY_LIMIT=5
AI_GLOBAL_DAILY_LIMIT=60
# AI_MAX_TOKENS=350

# --- Solo sviluppo/test ---
# VITE_FORCE_DEMO=1        forza la modalità demo nel client
# MAIL_PROVIDER=outbox     scrive le email in un file invece di inviarle (mai in produzione)
# MAIL_OUTBOX_FILE=./data/outbox.jsonl

# --- Firestore / Cloud Run (vedi docs/DEPLOY-FIREBASE.md) ---
# STORAGE=firestore            usa Firestore invece del file JSON (credenziali automatiche su Cloud Run)
# FIRESTORE_PROJECT_ID=podismoapp
# FIRESTORE_DATABASE_ID=(default)
# FIRESTORE_PREFIX=podismo_
# SESSION_COOKIE_NAME=__session   solo se passi da Firebase Hosting (inoltra solo quel cookie)
# ALLOWED_HOSTS=tuodominio.it,podismoapp.web.app

# Medaglie fisiche: catalogo pubblico di link HTTPS al sito del venditore.
# Vuoto = nessun banner commerciale. Configurare solo prodotti reali.
# MEDAL_SHOP_CATALOG=[]
