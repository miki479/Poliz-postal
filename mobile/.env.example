# Client ID pubblico OAuth di tipo iOS: bundle it.runngo.app.
# Serve durante la build nativa per registrare lo schema di ritorno Google.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# URL del backend (facoltativo: di default usa il server Runngo).
# EXPO_PUBLIC_API_URL=http://localhost:8787
# Il Web Client ID atteso arriva dal backend: impostare GOOGLE_CLIENT_ID sul server.
# Nessun client secret nell'app.
